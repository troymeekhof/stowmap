      <sparkle:shortVersionString>1.0.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Fixes the app icon in System Settings. On network shares, space outside the share is now labelled Elsewhere on this server.</p>]]></description>
