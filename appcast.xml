    <item>
      <title>Version 1.1</title>
      <pubDate>Tue, 17 Nov 2026 19:33:55 GMT</pubDate>
      <sparkle:version>1.1</sparkle:version>
      <sparkle:shortVersionString>1.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>New: search across every scanned drive (Cmd-F) and a Duplicates view that finds identical files across drives. Rescan your drives once so copies can be matched.</p>]]></description>
      <enclosure url="https://github.com/troymeekhof/stowmap/releases/download/v1.1/Stowmap-1.1.zip" type="application/octet-stream" sparkle:edSignature="sxQznT7BQnJOhubv9Rjjba2Fbka7RTbI6LxCpMLUK4r5FEQ83lErIJl90IxVEfU62WiAq9FYoNk/jPN84MxABg==" length="3005307" />
