    <title>Stowmap</title>
    <item>
      <title>Version 1.3</title>
      <pubDate>Tue, 17 Nov 2026 21:34:55 GMT</pubDate>
      <sparkle:version>1.3</sparkle:version>
      <sparkle:shortVersionString>1.3</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>New: Copy &amp; Verify with checksum verification to up to three destinations, and Check a Copy. Faster mapping of network shares. Time-left estimates. Permanent delete, with confirmation, on drives that have no Trash. Leave Feedback button.</p>]]></description>
      <enclosure url="https://github.com/troymeekhof/stowmap/releases/download/v1.3/Stowmap-1.3.zip" type="application/octet-stream" sparkle:edSignature="0RP6L549DRC5X0R1oYo1HOHjPP+zgvXPv3sH4FiXANCxG9bW4/XPTc/fSTX8614n3YGwOfNS90AM/ojwdn36BQ==" length="3942153" />
    </item>
    <item>
      <title>Version 1.2.3</title>
      <pubDate>Tue, 17 Nov 2026 20:40:48 GMT</pubDate>
      <sparkle:version>1.2.3</sparkle:version>
      <sparkle:shortVersionString>1.2.3</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>A network share&#x27;s map now shows only what is in that share. New Scan All Drives button. Drive rows show scan progress while scanning.</p>]]></description>
      <enclosure url="https://github.com/troymeekhof/stowmap/releases/download/v1.2.3/Stowmap-1.2.3.zip" type="application/octet-stream" sparkle:edSignature="Cq0VbQpFAUlFPmBxQz3U78zFTVHox4h1Byh/U4TZtmnRG6rXD3+RURr6OCVXh+2DPC3H2A5Z65SMlaxS6ZLSAA==" length="3222398" />
    </item>
    <item>
      <title>Version 1.2.2</title>
      <pubDate>Tue, 17 Nov 2026 20:27:19 GMT</pubDate>
      <sparkle:version>1.2.2</sparkle:version>
      <sparkle:shortVersionString>1.2.2</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Duplicates now skips system and app files by default and lets you ignore any folder. Stowmap no longer offers macOS&#x27;s own files to the Collector.</p>]]></description>
      <enclosure url="https://github.com/troymeekhof/stowmap/releases/download/v1.2.2/Stowmap-1.2.2.zip" type="application/octet-stream" sparkle:edSignature="zQfmTRg3DGi+TSuPArdkvJlwfnc7r1X/Cml2qZQJ3tNS49Qc4xNB7boNvD6vUGrwWbCaLNvObpr9wTCtnVqwCw==" length="3191786" />
    </item>
    <item>
      <title>Version 1.2.1</title>
      <pubDate>Tue, 17 Nov 2026 20:18:47 GMT</pubDate>
      <sparkle:version>1.2.1</sparkle:version>
      <sparkle:shortVersionString>1.2.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>The Duplicates row in the sidebar shows a progress bar while it works. Verify shows a bar and percentage on each row and can be stopped. Adds a 10 GB minimum size.</p>]]></description>
      <enclosure url="https://github.com/troymeekhof/stowmap/releases/download/v1.2.1/Stowmap-1.2.1.zip" type="application/octet-stream" sparkle:edSignature="qz7ayoLc0xuuREhpNBVGfx5aju9WXHjK1Ji5PrXT1Weaqjv5p65Hdvl4X2z6tV5nxg+O/1Q0PcM+ykL2bJk1CA==" length="3158528" />
